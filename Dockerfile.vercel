FROM composer:2 AS php-dependencies

WORKDIR /app

COPY . .

RUN rm -f bootstrap/cache/*.php \
    && composer install \
    --no-dev \
    --no-interaction \
    --no-progress \
    --prefer-dist \
    --optimize-autoloader \
    --no-scripts \
    --ignore-platform-reqs

FROM node:22-bookworm-slim AS frontend-assets

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

ARG VITE_APP_NAME=ClassCheck
ENV VITE_APP_NAME=${VITE_APP_NAME}

RUN npm run build

FROM dunglas/frankenphp:1.13.2-php8.5-alpine@sha256:f4947926b4c5070176be7c72b03939e045f7ae9d249a3219cf9708bd5e6d0ff2 AS runtime

WORKDIR /app

RUN php -r 'printf("Verified PHP runtime: %s\n", PHP_VERSION); exit(PHP_VERSION_ID >= 80512 ? 0 : 1);' \
    && cp "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini" \
    && install-php-extensions \
        bcmath \
        dom \
        gd \
        intl \
        mbstring \
        opcache \
        pdo_pgsql \
        xml \
        zip

COPY . .
COPY --from=php-dependencies /app/vendor ./vendor
COPY --from=frontend-assets /app/public/build ./public/build
COPY Caddyfile /etc/caddy/Caddyfile
COPY docker/php-production.ini /usr/local/etc/php/conf.d/zz-classcheck-production.ini
COPY docker/vercel-entrypoint.sh /usr/local/bin/vercel-entrypoint

RUN rm -f bootstrap/cache/*.php \
    && php artisan package:discover --ansi

RUN mkdir -p \
        bootstrap/cache \
        storage/app/private \
        storage/app/public \
        storage/framework/cache/data \
        storage/framework/sessions \
        storage/framework/views \
        storage/logs \
    && chmod -R a+rwX bootstrap/cache storage

ENV APP_ENV=production \
    APP_DEBUG=false \
    DB_CONNECTION=pgsql \
    SESSION_DRIVER=database \
    CACHE_STORE=database \
    QUEUE_CONNECTION=database \
    SESSION_SECURE_COOKIE=true \
    LOG_CHANNEL=stderr \
    LOG_LEVEL=warning \
    PORT=80

EXPOSE 80

ENTRYPOINT ["sh", "/usr/local/bin/vercel-entrypoint"]
